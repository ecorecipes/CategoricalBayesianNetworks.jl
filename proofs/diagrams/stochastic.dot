digraph stochastic {
  graph [rankdir=LR, bgcolor="white", pad=0.2, nodesep=0.5, ranksep=0.6];
  node [fontname="Helvetica", fontsize=12, color="#334155"];
  edge [fontname="Helvetica", fontsize=10, color="#475569", arrowsize=0.7];
  x [label="input x\nfalse / true", shape=ellipse];
  parity [label="ordered parity\nx XOR x", shape=box, style=rounded];
  v [label="visible = false", shape=ellipse];
  prior [label="hidden prior\nP(false) = 1/3\nP(true) = 2/3", shape=box, style=rounded];
  h [label="hidden state\nsummed out", shape=ellipse];
  o0 [label="output 0 = x", shape=plaintext];
  o1 [label="output 1 = false", shape=plaintext];
  o2 [label="output 2 = false", shape=plaintext];
  x -> parity [label="slot 0"];
  x -> parity [label="slot 1"];
  parity -> v;
  prior -> h;
  x -> o0 [color="#0369a1", label="pass-through"];
  v -> o1 [color="#0369a1"];
  v -> o2 [color="#0369a1", label="copy"];
  { rank=same; parity; prior; }
  { rank=same; v; h; }
  { rank=same; o0; o1; o2; }
}
